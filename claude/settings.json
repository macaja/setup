{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Skill(caveman-commit)"
    ]
  },
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
