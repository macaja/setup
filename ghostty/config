# Ghostty configuration
# Docs: https://ghostty.org/docs/config
# Reload live: cmd+shift+, — no restart needed
# Full reference: ghostty +show-config --default --docs

# ── Font ──────────────────────────────────────────────
font-family = Menlo
# Installed mono alternatives: Andale Mono, Monaco, PT Mono, Courier New
# For ligatures + icon glyphs (starship/p10k): install a Nerd Font, e.g.
#   font-family = JetBrainsMono Nerd Font
font-size = 13

# ── Theme ─────────────────────────────────────────────
theme = TokyoNight
# Browse 300+: ghostty +list-themes

# ── Split identification — make active split obvious ──
# Dim inactive splits hard (lower = more dimmed). Big gap = active pops.
unfocused-split-opacity = 0.35
# Tint inactive splits toward background so they recede
unfocused-split-fill = 1a1b26
# Bright theme-blue divider frames the active split
split-divider-color = 7aa2f7

# ── Transparency ──────────────────────────────────────
# 0 = fully transparent, 1 = opaque. Tweak to taste.
background-opacity = 0.85
# macOS blur behind the window so text stays readable (higher = blurrier)
background-blur = 20

# ── Window / macOS ────────────────────────────────────
macos-titlebar-style = tabs
window-save-state = always
mouse-hide-while-typing = true
copy-on-select = true
cursor-style = block

# ── Shell integration (zsh) ───────────────────────────
# Gives: jump between prompts (cmd+up/down), cwd inheritance on
# new split/tab, command duration, auto tab titles from cwd.
shell-integration = zsh
# 'title' dropped so Claude auto-naming sticks (zsh won't overwrite on cd)
shell-integration-features = cursor,sudo

# ── Quick terminal (drop-down from anywhere) ──────────
quick-terminal-position = top
quick-terminal-animation-duration = 0.1

# ── Keybinds ──────────────────────────────────────────
# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+w=close_surface

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+o=toggle_tab_overview

# Name the current tab (interactive prompt)
keybind = cmd+shift+i=prompt_tab_title

# Global drop-down terminal (works even when Ghostty not focused)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Config
keybind = cmd+comma=open_config
keybind = cmd+shift+comma=reload_config
