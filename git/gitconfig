# work identity for pipelabs repos, matched by remote URL (ssh or https)
# so it works on any machine regardless of folder layout
[includeIf "hasconfig:remote.*.url:git@github.com:pipelabs/**"]
	path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://github.com/pipelabs/**"]
	path = ~/.gitconfig-work

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true
    line-numbers = true

[alias]
    # whole branch diff vs main — what the PR will show
    prdiff = diff main...HEAD

[merge]
    conflictStyle = zdiff3

