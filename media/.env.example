# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Owner of the files the containers write. On Linux: `id -u` / `id -g`.
# On Docker Desktop for Mac these are ignored, leave them as-is.
PUID=1000
PGID=1000
TZ=Australia/Melbourne

# One shared root for downloads and the final library, so radarr/sonarr can
# hardlink instead of copying. Must contain torrents/ and media/.
DATA_ROOT=/path/to/data

# Your LAN, so the VPN firewall still lets the web UIs answer from other machines.
LAN_SUBNET=192.168.1.0/24

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn

# openvpn credentials (leave blank if VPN_TYPE=wireguard).
# ProtonVPN: use the OpenVPN username from the account page, not the login
# email, and append +pmp to it to get port forwarding.
OPENVPN_USER=
OPENVPN_PASSWORD=

# wireguard credentials (leave blank if VPN_TYPE=openvpn)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Optional: pin exit countries, comma separated. Blank = anywhere.
SERVER_COUNTRIES=

QBITTORRENT_PORT=8080
